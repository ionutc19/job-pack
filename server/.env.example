# AI Provider Configuration
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your-api-key-here
AI_MODEL=gpt-4o
AI_TIMEOUT_SECONDS=30

# GitHub Integration (for feedback/bug reports)
GITHUB_TOKEN=your-github-token-here
GITHUB_REPO_OWNER=ionutc19
GITHUB_REPO_NAME=job-pack

# Database (SQLite for local dev, PostgreSQL-compatible schema)
DATABASE_URL=sqlite:///data/jobcoach.db

# Google Play Billing
GOOGLE_PLAY_PACKAGE=com.ionutc19.jobcoach
# Path to service account JSON for Play Developer API:
GOOGLE_PLAY_CREDENTIALS_JSON=
# Shared secret for RTDN webhook verification:
RTDN_SECRET=

# Admin access (for debug tier override endpoint)
ADMIN_SECRET=

# Server
HOST=0.0.0.0
PORT=8000

# For Azure-hosted models (OpenAI-compatible /responses API):
# AI_PROVIDER=azure_openai
# AI_BASE_URL=https://your-resource.services.ai.azure.com/openai/v1
# AI_API_KEY=your-azure-api-key
# AI_MODEL=gpt-5.4-mini
# AI_TIMEOUT_SECONDS=60
